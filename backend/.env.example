# Salin ke .env (JANGAN di-commit)
PORT=4000
NODE_ENV=development

# Origin frontend yang diizinkan CORS (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (Supabase / Neon). Contoh: postgresql://user:pass@host:5432/dbname
DATABASE_URL=
JWT_SECRET=
# Neon/Supabase biasanya butuh SSL
DATABASE_SSL=true

# true = dashboard endpoint melayani JSON mock dari DS (src/mock) tanpa database
USE_MOCK_DATA=true

# Layanan FastAPI Tim AE (dipanggil HANYA dari backend)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=15000
